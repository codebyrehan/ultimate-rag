# =====================================================================
# Ultimate RAG Platform — environment configuration
# Copy to .env and adjust. NEVER commit real secrets.
# All values below are safe-to-share defaults for local development.
# =====================================================================

# ---- Server ----
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true

# ---- Database ----
# Local SQLite fallback (no external service): sqlite+aiosqlite:///./rag.db
DATABASE_URL=sqlite+aiosqlite:///./rag.db
# Supabase PostgreSQL example:
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20

# ---- Redis / queue ----
REDIS_URL=redis://localhost:6379/0
# Set INLINE_WORKER=1 to run background jobs in-process (no Redis needed) for dev/tests.
INLINE_WORKER=1
# Cache layer: set CACHE_ENABLED=false to disable caching entirely (in-memory fallback).
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300

# ---- Security ----
SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_SECONDS=3600
REFRESH_EXPIRE_SECONDS=86400
BCRYPT_ROUNDS=12

# ---- Upload storage ----
UPLOAD_STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
ALLOWED_MIME_TYPES=application/pdf

# ---- Rate limiting (token bucket) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REGISTER_PER_MIN=10
RATE_LIMIT_LOGIN_PER_MIN=20
RATE_LIMIT_UPLOAD_PER_MIN=10
RATE_LIMIT_QUERY_PER_MIN=60

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000,http://localhost:8051,http://localhost:8501

# ---- Embeddings ----
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_LENGTH=512
# Optional OpenAI-compatible fallback (leave empty to stay local)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---- Vector store ----
VECTOR_STORE_PROVIDER=in_memory
QDRANT_URL=http://localhost:6333
VECTOR_STORE_COLLECTION=rag_chunks
USE_IVF_INDEX=true
HNSW_M=32
HNSW_EF=128

# ---- BM25 ----
BM25_PROVIDER=sklearn
BM25_TOP_K=20

# ---- Reranker ----
RERANKER_PROVIDER=cross_encoder
RERANKER_MODEL=BMW/rag-dense-zeroshot-mr2-reranker_2
# RERANKER_MODEL=thenlper/gte-reranker-multilingual-large
RERANKER_TOP_K=20
RERANKER_MIN_SCORE=-10

# ---- Chunking ----
CHUNKER_PROVIDER=semantic
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
PARENT_CHUNK_SIZE=4000
CHUNK_SENTENCE_THRESH=110

# ---- Ingestion ----
OCR_PROVIDER=tesseract
OCR_ENABLED=true
OCR_LANG=eng
TABLES_ENABLED=true
MAX_PAGES_PER_JOB=2000
MAX_EMBEDDING_WORKERS=2

# ---- Retrieval ----
DENSE_RETRIEVAL_ENABLED=true
DENSE_TOP_K=20
DENSE_WEIGHT=0.6
LEXICAL_WEIGHT=0.4
RRF_K=60
RRF_DEDUP=false
FINAL_TOP_K=10
HYBRID_FUSION=topk

# ---- Query transformation ----
QUERY_REWRITE_ENABLED=true
QUERY_EXPANSION_ENABLED=false
MULTI_QUERY_ENABLED=false
HYDE_ENABLED=false
FOLLOWUP_DETECTION=true

# ---- LLM generation ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen3:4b
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_TOP_P=0.9
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_STREAMING_ENABLED=true
# When the configured LLM is unavailable, fall back to a local HF generator
# (requires the transformers extra). Leave empty to disable the fallback.
LOCAL_HF_MODEL=
LOCAL_HF_MAX_NEW_TOKENS=512

# ---- Verification ----
CLAIM_EXTRACTION_ENABLED=true
FAITHFULNESS_CHECK_ENABLED=true
RELEVANCE_CHECK_ENABLED=true
CONFIDENCE_ENABLED=true
NLI_SIMILARITY_THRESHOLD=0.65

# ---- Observability ----
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
ENABLE_REQUEST_LOGGING=true

# ---- Multi-tenant (dev) ----
DEFAULT_TENANT_ID=tenant_local
